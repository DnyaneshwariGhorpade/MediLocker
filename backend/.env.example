# MediLocker backend configuration.
# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- database
# Transaction-mode pooler (application queries).
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Session-mode pooler (migrations). Falls back to DATABASE_URL if unset.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ------------------------------------------------------------------ server
NODE_ENV=development
PORT=3000
# Comma-separated list of browser origins permitted to call the API.
CORS_ORIGIN=http://localhost:5173

# --------------------------------------------------------------- security
# Required. Minimum 32 characters. Startup aborts if missing or a known
# placeholder. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Token lifetimes (zeit/ms format).
MFA_TOKEN_TTL=5m
SESSION_TOKEN_TTL=2h

BCRYPT_ROUNDS=10

# Account lockout.
MAX_FAILED_LOGINS=10
LOCKOUT_MINUTES=15

# Rate limiting.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Audit chain.
# First log_id belonging to the hash chain. Leave unset for a fresh
# database. Set it when migrating a table that already holds entries
# written before chaining existed (see scripts/resetAuditChain.ts).
AUDIT_CHAIN_GENESIS_LOG_ID=

# ------------------------------------------------------- platform services
# Optional. Without it, consent caching uses an in-process map that is not
# shared between instances. The system-health screen reports which is in use.
REDIS_URL=

# Set false to run an instance that serves traffic but runs no scheduled jobs.
SCHEDULER_ENABLED=true

# Key provider: LOCAL (master key from KMS_MASTER_KEY) or KMS (AWS).
KEY_PROVIDER=LOCAL
AWS_REGION=ap-south-1
AWS_KMS_KEY_ID=
S3_BUCKET=

# Notification delivery. Unset means delivery is simulated and rows are marked
# SIMULATED rather than DELIVERED.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_API_URL=
SMS_API_KEY=
